# =============================================================================
# prrrtpal-housewarming-theme — frontend environment
# Copy to .env for local dev. Vite bakes these at BUILD time — restart
# `npm run dev` (or rebuild) after changing them.
# On Cloudflare Pages, set these as build environment variables.
# =============================================================================

# The backend API. Local dev points at the local backend; production points at Render.
VITE_API_URL=http://localhost:3000
# VITE_API_URL=https://prrrtpal-housewarming-api.onrender.com

# Cloudinary unsigned uploads (guest photos, game center images, voice notes).
# The preset must be UNSIGNED and must allow image + video/audio resource types.
# Leave blank to run without uploads (the UI falls back gracefully).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
