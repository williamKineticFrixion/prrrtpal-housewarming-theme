# =============================================================================
# prrrtpal-housewarming-theme — backend environment
# Copy to .env for local dev. NEVER commit .env (it's gitignored).
# On Render, set these in the service's Environment tab instead.
# =============================================================================

# ---- Database ----
# LOCAL DEV, option A — local Postgres (SSL auto-disables for localhost hosts):
DATABASE_URL=postgresql://YOUR_MAC_USER@localhost:5432/housewarming
# LOCAL DEV, option B — a Neon DEV BRANCH (pooled string, keep sslmode=require):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# PRODUCTION — the production Neon pooled string. Belongs ONLY in Render's
# environment tab. Never point local dev at production.

# ---- Auth ----
# Locally: any long random string. On Render: generated for you (see render.yaml).
JWT_SECRET=replace-with-a-long-random-string
GUEST_PASSCODE=welcome-home
ADMIN_PASSCODE=host-pass
FAMILY_PASSCODE=family-pass

# ---- CORS ----
# Origins allowed to call this API, comma-separated (no spaces around commas).
# Local dev needs the Vite origin; add your Cloudflare Pages URL for production.
CLIENT_ORIGIN=http://localhost:5173

# ---- Event seed defaults (optional) ----
# These only seed the FIRST boot. After that, the host edits everything live
# from the Host panel (stored in the settings table) — no redeploy needed.
# EVENT_FAMILY_NAME=The Fontanez Family
# EVENT_TAGLINE=good food, good friends, and a grand tour of the new place
# EVENT_DATE=2026-08-15T15:00:00
# EVENT_TIME_LABEL=3:00 – 8:00 PM
# EVENT_VENUE=The New Fontanez Home
# EVENT_ADDRESS=123 Maple Lane, Roebling, NJ
# EVENT_HOST_NOTE=Come see the new place! RSVP below so we know how many chairs to borrow.
# EVENT_RSVP_DEADLINE=August 8
# EVENT_REGISTRY_URL=
# EVENT_DISH_CATEGORIES=Appetizers,Mains,Sides,Desserts,Drinks
# EVENT_DEFAULT_THEME=day            # day | night (initial day/night mode)
# EVENT_REQUIRE_RSVP_APPROVAL=true   # gate the address behind host-approved RSVPs (host can toggle live)
# EVENT_GUEST_CODE_ENABLED=true      # whether the guest passcode works at boot (host can toggle live)
# EVENT_THEME_NAME=warm              # warm | pool (initial site theme; host can switch live)

# ---- Photo gallery (optional) ----
# GALLERY_REQUIRE_APPROVAL=false     # true = guest photos need admin approval
# Backend Cloudinary keys are ONLY needed for the admin "Import from Cloudinary"
# button. Guest uploads use the frontend's unsigned preset instead.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_IMPORT_FOLDER=
# CLOUDINARY_IMPORT_TAG=

# ---- Server ----
# PORT=3000
